+    /// e2e 生物 WAT：on_tick 每拍发信 "WHERE?"；bridge_on_reply 扫回信数字存
+    /// $cmd——假服务器回 {"dx":3} 含数字 3，$cmd 从 0 变 3 = 行为改变的断言锚
+    ///（与 players/bridge-demo.wat 同款解析逻辑的测试缩小版）
+    const BRIDGE_E2E_WAT: &str = r#"(module
+  (import "env" "bridge_send" (func $bridge_send (param i32 i32 i32) (result i32)))
+  (global $cmd (mut i32) (i32.const 0))
+  (memory (export "memory") 1)
+  (data (i32.const 0) "WHERE?")
+  (func $scan_digit (param $ptr i32) (param $len i32) (result i32)
+    (local $i i32) (local $c i32)
+    (block $done
+      (loop $loop
+        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
+        (local.set $c (i32.load8_u (i32.add (local.get $ptr) (local.get $i))))
+        (if (i32.and (i32.ge_u (local.get $c) (i32.const 48)) (i32.le_u (local.get $c) (i32.const 57)))
+          (then (return (i32.sub (local.get $c) (i32.const 48)))))
+        (local.set $i (i32.add (local.get $i) (i32.const 1)))
+        (br $loop)))
+    i32.const 0)
+  (func (export "on_tick")
+    i32.const 1 i32.const 0 i32.const 6 call $bridge_send drop)
+  (func (export "bridge_on_reply") (param $port i32) (param $ptr i32) (param $len i32)
+    (global.set $cmd (call $scan_digit (local.get $ptr) (local.get $len))))
+  (func (export "life") (result i32) i32.const 1)
+  (func (export "get_cmd") (result i32) (global.get $cmd)))"#;
+
+    /// 迷你桥服务器：accept 两次（两拍各一封），每请求回 200 {"dx":3}，
+    /// 收到的请求体经通道交回主线程断言
+    #[test]
+    #[ignore = "bridge-e2e: 需本地回环网络"]
+    fn bridge_e2e_reply_changes_behavior_across_ticks() {
+        use std::io::{Read as _, Write as _};
+        // 全链路（D-001b 五步链，进程内）：拍1 bridge_send 排队 -> a-1 出站 ->
+        // worker 手搓 HTTP -> 迷你服务器收信回 {"dx":3} -> 拍2 a-1 回信投递
+        // bridge_on_reply -> 造物全局 $cmd=3（行为改变的肉眼证据等价物）
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let (req_tx, req_rx) = std::sync::mpsc::channel::<Vec<u8>>();
+        let server = std::thread::spawn(move || {
+            for _ in 0..2 {
+                let (mut stream, _) = match listener.accept() {
+                    Ok(s) => s,
+                    Err(_) => return,
+                };
+                stream
+                    .set_read_timeout(Some(std::time::Duration::from_secs(5)))
+                    .ok();
+                let mut req = Vec::new();
+                let mut buf = [0u8; 4096];
+                loop {
+                    match stream.read(&mut buf) {
+                        Ok(0) => break,
+                        Ok(n) => {
+                            req.extend_from_slice(&buf[..n]);
+                            let has_body = req
+                                .windows(4)
+                                .position(|w| w == b"\r\n\r\n")
+                                .map(|pos| {
+                                    let cl = req[..pos]
+                                        .split(|b| *b == b'\n')
+                                        .find_map(|line| {
+                                            let s = std::str::from_utf8(line).ok()?;
+                                            s.to_ascii_lowercase()
+                                                .strip_prefix("content-length:")
+                                                .map(|v| v.trim().parse::<usize>().ok())?
+                                        })
+                                        .unwrap_or(0);
+                                    req.len() >= pos + 4 + cl
+                                })
+                                .unwrap_or(false);
+                            if has_body {
+                                break;
+                            }
+                        }
+                        Err(_) => break,
+                    }
+                }
+                let _ = req_tx.send(req);
+                let _ = stream.write_all(
+                    b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 9\r\nConnection: close\r\n\r\n{\"dx\":3}",
+                );
+                let _ = stream.flush();
+            }
+        });
+        // 保险库指向迷你服务器
+        let vault_path = std::env::temp_dir().join(format!(
+            "cw-bridge-e2e-{}-{}.json",
+            std::process::id(),
+            Uuid::new_v4().simple()
+        ));
+        std::fs::write(
+            &vault_path,
+            serde_json::to_string(&serde_json::json!([{
+                "port": 1,
+                "url": format!("http://127.0.0.1:{port}/hook"),
+            }]))
+            .unwrap(),
+        )
+        .unwrap();
+        // 战场脚手架：单实体挂 e2e 生物 + 带 worker 桥
+        let mut world = WorldState::new();
+        let id = EntityId(Uuid::from_u128(88));
+        world.entities.insert(id, make_entity(88, (0.0, 0.0)));
+        let mut time = TimeEngine::new();
+        let physics = DefaultPhysicsEngine::new();
+        let mut renderer = test_renderer();
+        let mut storage = StorageEngine::open_in_memory().unwrap();
+        let mut pending: Vec<PendingChange> = Vec::new();
+        let mut map = test_sandbox_map();
+        map.create(id, &wasm(BRIDGE_E2E_WAT), 1_000_000).unwrap();
+        map.bridge = Some(bridges::BridgeOutbox::new(&vault_path, 5).unwrap());
+        // 拍1：发信出站（worker 异步 HTTP）
+        tick(
+            &mut world,
+            &mut time,
+            &physics,
+            &mut renderer,
+            &mut storage,
+            &mut pending,
+            &mut map,
+        );
+        // 等 worker 往返（本机毫秒级；200ms 富余）+ 服务器收到第一封
+        let first = req_rx
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .expect("服务器应收到第一封信");
+        let req_text = String::from_utf8_lossy(&first);
+        assert!(req_text.starts_with("POST /hook HTTP/1.1"), "信应发往登记路径");
+        assert!(req_text.contains("\"payload\":[87,72,69,82,69,63]"), "信封应内嵌 WHERE? 字节");
+        std::thread::sleep(std::time::Duration::from_millis(200));
+        // 拍2：回信投递 bridge_on_reply（拍边界锚），同时拍2 出站第二封
+        tick(
+            &mut world,
+            &mut time,
+            &physics,
+            &mut renderer,
+            &mut storage,
+            &mut pending,
+            &mut map,
+        );
+        // 造物行为改变：$cmd 从 0 变 3（回信 {"dx":3} 的数字被造物读到）
+        let handle = map.sandboxes.get_mut(&id).unwrap();
+        let func = handle
+            .instance
+            .get_typed_func::<(), i32>(&mut handle.store, "get_cmd")
+            .unwrap();
+        let cmd = func.call(&mut handle.store, ()).unwrap();
+        assert_eq!(cmd, 3, "回信数字 3 应写进造物全局（行为改变）");
+        // 第二封信照常出站（每拍 1 发节律的跨拍连续性）
+        let _second = req_rx.recv_timeout(std::time::Duration::from_secs(5));
+        server.join().unwrap();
+        let _ = std::fs::remove_file(&vault_path);
+    }
