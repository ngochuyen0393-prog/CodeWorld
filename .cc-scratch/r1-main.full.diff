+        assert!(!d.bridge_sent_this_tick, "collect 后 sent 标记应清");
+        assert!(d.bridge_pending.is_empty(), "collect 后 pending 应清空");
+        assert_eq!(d.bridge_inflight, 1, "在途 +1");
